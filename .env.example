# Copy this file to .env.local and fill in the values.

# Public address of the app (used in magic-link emails).
APP_URL=http://localhost:3000

# Long random string used to sign sessions and login links.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Who may sign in, and their Telegram user id (the id the LeadOps bots know them by).
# Format: email:telegramId, comma separated.
OWNERS=admin@mohamad-saad.com:1487367586

# n8n "LeadOps W1 — Web App API" webhook and its key (header x-leadops-key).
N8N_API_URL=https://n8n.mohamad-saad.com/webhook/leadops-web-api
N8N_API_KEY=

# SMTP for magic-link emails. Leave SMTP_HOST empty in development:
# the sign-in link is then printed in the terminal running `npm run dev`.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LeadOps <no-reply@mohamad-saad.com>"

# true = use built-in sample data and canned bot replies (no n8n needed).
DEMO_MODE=false
